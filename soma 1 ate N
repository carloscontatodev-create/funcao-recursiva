#include <stdio.h>
#include <stdlib.h>

int somaRecursiva(int n) {
    if (n <= 0) {
        return 0;
    }
    return n + somaRecursiva(n - 1);
}

int main() {
    int n;
    
    printf("Digite um valor para N: ");
    scanf("%d", &n);
    
    printf("A soma de 1 ate %d e: %d\n", n, somaRecursiva(n));
    
    system("pause");
    return 0;
}
